{
    "name": "@fresnica/ui-native",
    "version": "1.0.0",
    "description": "Android-first React Native adapter for the Fresnica design system",
    "author": "Pixman <pixhonic@gmail.com>",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=22.13.0"
    },
    "peerDependencies": {
        "react": "19.2.3",
        "react-native": "0.87.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "format:check": "prettier --check .",
        "generate:tokens": "node scripts/generate-native-token-contract.mjs",
        "validate:tokens": "node scripts/validate-token-source.mjs",
        "test:theme": "node --experimental-strip-types scripts/test-theme.mjs",
        "test:contracts": "node scripts/test-component-contracts.mjs",
        "build": "tsc -p tsconfig.build.json",
        "test:render": "jest --runInBand",
        "test": "npm run typecheck && npm run format:check && npm run validate:tokens && npm run test:theme && npm run test:contracts"
    },
    "devDependencies": {
        "@testing-library/react-native": "^13.2.0",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.0.0",
        "babel-jest": "^30.1.2",
        "jest": "^30.1.3",
        "prettier": "^3.4.0",
        "react": "19.2.3",
        "react-native": "0.87.0",
        "react-test-renderer": "^19.2.3",
        "typescript": "6.0.3"
    }
}
