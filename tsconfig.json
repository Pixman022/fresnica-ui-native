{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "strict": true,
        "jsx": "react-jsx",
        "lib": ["ES2022"],
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedModules": true,
        "types": ["react", "react-native"]
    },
    "include": ["src", "scripts"]
}
